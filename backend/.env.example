# ---------------------------------------------------------------------------
# Market Intelligence India - backend environment
# Copy to `.env` and edit. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# DEMO | LOCAL | STAGING | PRODUCTION
# DEMO    -> seeded sample rows are served and labelled DEMO in every payload
# LOCAL   -> live providers enabled, demo rows still visible but labelled
# STAGING -> live providers enabled, demo rows hidden
# PRODUCTION -> live providers only; the app refuses to serve demo rows
APP_ENV=PRODUCTION

# Secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-anything
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./market_intel.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/market_intel

# --- Cache ---------------------------------------------------------------
# Leave blank to use the built-in in-process TTL cache (fine for a single
# uvicorn worker). Set to a redis:// URL to use Redis / Upstash.
REDIS_URL=

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Data providers ------------------------------------------------------
# Comma-separated, highest priority first. Available adapters:
#   yahoo   - Yahoo Finance via yfinance (free, delayed, no key)
#   nse     - NSE India public JSON endpoints (free, subject to NSE's terms)
#   manual  - rows entered by an admin through /api/admin
#   demo    - seeded sample rows (never served when APP_ENV=PRODUCTION)
#   angelone/dhan/kite/upstox - YOUR broker account (real-time, licensed)
#   nse_archives / bse_archives - official published EOD files
#   amfi / rbi / worldbank      - official reference and macro data
QUOTE_PROVIDERS=yahoo,nse,manual
HISTORY_PROVIDERS=yahoo,manual
OPTION_CHAIN_PROVIDERS=nse,manual
NEWS_PROVIDERS=google_news_rss,manual
IPO_PROVIDERS=manual
EOD_PROVIDERS=nse_archives,bse_archives
MACRO_PROVIDERS=worldbank,rbi

# A configured broker is inserted at the head of the quote, history and
# option-chain chains automatically - it is the only real-time source, so
# it should always be tried first. Unconfigured brokers are removed from
# every chain rather than burning a failover slot.

# The NSE adapter is OFF by default. NSE's terms of use restrict automated
# access to its site endpoints, so enabling it is the operator's decision to
# make knowingly. Read https://www.nseindia.com/terms-conditions first.
# While it is off, option-chain and futures panels report UNAVAILABLE unless a
# manual or licensed provider supplies them - which is the honest state.
ENABLE_NSE_PROVIDER=false
NSE_REQUESTS_PER_MINUTE=20
YAHOO_REQUESTS_PER_MINUTE=60

# --- Optional third-party keys (all features degrade gracefully) ---------
NEWS_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Notification channels (all optional) --------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Scheduler -----------------------------------------------------------
ENABLE_SCHEDULER=true
QUOTE_REFRESH_SECONDS_MARKET_HOURS=60
QUOTE_REFRESH_SECONDS_OFF_HOURS=900

# --- Bootstrap admin -----------------------------------------------------
# Created on first start if no user exists. Change the password immediately.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=


# --- Personal / single-operator mode -------------------------------------
# This is a private research desk for one analyst, not a service offered to
# others. Setting this drops the "distributing research to third parties"
# framing from the disclaimers. It changes NO provenance rule: every value is
# still stamped with its source, timestamp and status, which matters more when
# nobody else is checking your inputs.
PERSONAL_USE_MODE=true
OPERATOR_NAME=

# --- Exchange archives ---------------------------------------------------
# Official published bhavcopy / delivery / deal files. These are static
# downloads meant to be fetched - a different path from the site's internal
# JSON, which is why they are on by default while ENABLE_NSE_PROVIDER is not.
ENABLE_EXCHANGE_ARCHIVES=true
ARCHIVE_REQUESTS_PER_MINUTE=12

# --- Broker feed (the only genuinely real-time source) -------------------
# Leave every field blank to run without a broker; the platform then serves
# delayed and end-of-day data, labelled as such. Fill in exactly one broker.
#
# ANGEL ONE  - free with a demat account. https://smartapi.angelone.in
#   ANGELONE_PASSWORD is your MPIN. ANGELONE_TOTP_SECRET is the base32 string
#   shown when you enable TOTP (not the six-digit code).
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# DHAN - free with a demat account. https://dhanhq.co/docs/v2/
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ZERODHA KITE CONNECT - paid. The access token expires daily.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# UPSTOX - free with a demat account.
UPSTOX_ACCESS_TOKEN=

BROKER_REQUESTS_PER_MINUTE=180

# --- Scheduled ingestion -------------------------------------------------
# Service credential for the nightly EOD ingestion job. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes in the INGEST_TOKEN GitHub Actions secret. Leave blank
# and the ingestion endpoint accepts only an authenticated ADMIN session.
INGEST_TOKEN=
